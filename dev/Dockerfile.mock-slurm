# Local Slurm emulator for development (no cluster needed)
#
# Runs dev/mock_slurmrestd.py, which impersonates the slurmrestd REST API and runs
# submitted jobs on this container:
# - Default (WITH_PYSR=false): PySR searches are faked with least-squares equations, so the
#   image builds in seconds and needs no Julia. Good for UI and pipeline work.
# - WITH_PYSR=true: Julia + PySR are installed and precompiled, and PySR searches run for
#   real (LOCAL_PYSR=true in docker-compose.yml sets both the build arg and the runtime flag).
#   The first build takes 10-20 minutes.
#
# Build context must be the repo root (context: .)

FROM python:3.11-slim

ARG WITH_PYSR=false
ARG JULIA_VERSION=1.11.5
ARG TARGETARCH

# System deps
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Julia environment, as in slurm_worker/syxplain-worker.def: packages are resolved and
# precompiled into /opt at build time and loaded from there directly at run time
ENV JULIA_DEPOT_PATH=/opt/julia-depot \
    PYTHON_JULIAPKG_EXE=/opt/julia/bin/julia \
    PYTHON_JULIAPKG_PROJECT=/opt/julia-env \
    PYTHON_JULIACALL_EXE=/opt/julia/bin/julia \
    PYTHON_JULIACALL_PROJECT=/opt/julia-env

# Python deps: worker requirements (pysr/juliacall only with WITH_PYSR) + mock server deps
COPY slurm_worker/requirements.txt /tmp/worker-requirements.txt
RUN if [ "$WITH_PYSR" = "true" ]; then \
        cp /tmp/worker-requirements.txt /tmp/filtered-requirements.txt; \
    else \
        grep -v -E '^(pysr|juliacall)' /tmp/worker-requirements.txt > /tmp/filtered-requirements.txt; \
    fi \
    && pip install --no-cache-dir \
        -r /tmp/filtered-requirements.txt \
        fastapi \
        uvicorn[standard] \
    && rm /tmp/worker-requirements.txt /tmp/filtered-requirements.txt

# Julia + precompiled PySR packages (only with WITH_PYSR=true)
RUN if [ "$WITH_PYSR" = "true" ]; then \
        case "${TARGETARCH:-amd64}" in \
            amd64) JARCH=x64; JFILE=x86_64 ;; \
            arm64) JARCH=aarch64; JFILE=aarch64 ;; \
            *) echo "Unsupported architecture: $TARGETARCH" && exit 1 ;; \
        esac \
        && JMINOR=$(echo "$JULIA_VERSION" | cut -d. -f1,2) \
        && curl -fsSL "https://julialang-s3.julialang.org/bin/linux/${JARCH}/${JMINOR}/julia-${JULIA_VERSION}-linux-${JFILE}.tar.gz" \
            | tar -xz -C /opt \
        && mv "/opt/julia-${JULIA_VERSION}" /opt/julia \
        && cd "$(mktemp -d)" \
        && env -u PYTHON_JULIACALL_EXE -u PYTHON_JULIACALL_PROJECT \
            python -c "import pysr; pysr.load_all_packages()" \
        && python -c "import numpy as np; from pysr import PySRRegressor; X = np.random.randn(20, 2); PySRRegressor(niterations=2, verbosity=0, progress=False).fit(X, X[:, 0] * X[:, 1]); print('PySR warm-up complete')" \
        && cd / ; \
    fi

# Copy worker code and mock server
COPY slurm_worker/ /app/slurm_worker/
COPY dev/mock_slurmrestd.py /app/dev/mock_slurmrestd.py

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    LC_ALL=C.UTF-8 \
    LANG=C.UTF-8 \
    MOCK_SLURM_REAL_PYSR=$WITH_PYSR

WORKDIR /app
EXPOSE 6820

ENTRYPOINT ["python", "/app/dev/mock_slurmrestd.py", "--port", "6820"]
