# Syxplain Worker Singularity Definition
#
# Build: singularity build syxplain-worker.sif syxplain-worker.def
#
# This creates a container optimized for HPC environments with:
# - Python 3.11 with scientific computing stack
# - Julia 1.10.2 with PySR pre-compiled
# - SHAP and all required dependencies

Bootstrap: docker
From: python:3.11-slim

%labels
    Author Syxplain Team
    Version 1.0
    Description Syxplain compute worker for SHAP and PySR tasks on Slurm

%post
    # Install system dependencies
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
        git \
        ca-certificates \
        && rm -rf /var/lib/apt/lists/*

    # Install Julia (required for PySR)
    export JULIA_VERSION=1.10.2
    curl -fsSL https://julialang-s3.julialang.org/bin/linux/x64/1.10/julia-${JULIA_VERSION}-linux-x86_64.tar.gz | \
        tar -xz -C /opt
    ln -s /opt/julia-${JULIA_VERSION}/bin/julia /usr/local/bin/julia

    # Create app directory
    mkdir -p /app

    # Copy requirements and install Python dependencies
    # Note: requirements.txt must be in the same directory as the .def file during build
    pip install --no-cache-dir numpy pandas scipy scikit-learn shap pysr juliacall requests

    # Pre-compile Julia packages for PySR (this takes a while but speeds up runtime)
    python -c "
from pysr import PySRRegressor
import numpy as np
print('Pre-compiling PySR Julia packages...')
model = PySRRegressor(niterations=1, verbosity=0, progress=False)
X = np.random.randn(10, 2)
y = np.random.randn(10)
try:
    model.fit(X, y)
except:
    pass  # First run may fail but Julia is compiled
print('Julia pre-compilation complete')
" || true

    # Clean up (avoid /tmp and /var/tmp as they may contain host files with fakeroot)
    apt-get clean || true
    rm -rf /var/lib/apt/lists/* || true

%files
    # Copy worker code into container
    __init__.py /app/slurm_worker/__init__.py
    __main__.py /app/slurm_worker/__main__.py
    cli.py /app/slurm_worker/cli.py
    config.py /app/slurm_worker/config.py
    logging_config.py /app/slurm_worker/logging_config.py
    io/ /app/slurm_worker/io
    reporting/ /app/slurm_worker/reporting
    tasks/ /app/slurm_worker/tasks
    visualization/ /app/slurm_worker/visualization

%environment
    export PYTHONUNBUFFERED=1
    export PYTHONPATH=/app
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    # Julia threading - will be overridden by SLURM_CPUS_PER_TASK in the worker
    export JULIA_NUM_THREADS=${SLURM_CPUS_PER_TASK:-4}

%runscript
    exec python -m slurm_worker "$@"

%test
    python -c "import sys; sys.path.insert(0, '/app'); from slurm_worker import __version__; print(f'Version: {__version__}')"
    python -c "from pysr import PySRRegressor; print('PySR OK')"
    python -c "import shap; print('SHAP OK')"

%help
    Syxplain Worker Container

    This container runs compute-intensive tasks (SHAP and PySR) for the Syxplain
    symbolic regression analysis platform.

    Usage:
        singularity run syxplain-worker.sif --help
        singularity run syxplain-worker.sif --task-type shap --run-id <id> --input <file> --output <file>
        singularity run syxplain-worker.sif --task-type pysr --run-id <id> --input <file> --output <file>

    With bind mounts for data access:
        singularity run --bind /storage:/storage syxplain-worker.sif \
            --task-type shap \
            --run-id abc123 \
            --input /storage/staging/abc123/input.json \
            --output /storage/staging/abc123/output.json

    Environment variables (set before running):
        CALLBACK_URL   - Backend API URL for progress reporting
        CALLBACK_TOKEN - Authentication token for callbacks

    For more information, see: https://github.com/HUN-REN-AI1Science/syxplain
