# Syxplain Worker Singularity Definition
#
# Build: singularity build syxplain-worker.sif syxplain-worker.def
#
# This creates a container optimized for HPC environments with:
# - Python 3.11 with scientific computing stack
# - Julia 1.11 with PySR pre-compiled

Bootstrap: docker
From: python:3.11-slim

%labels
    Author Syxplain Team
    Version 3.0.0
    Description Syxplain compute worker for PySR tasks on Slurm

%post
    # Install system dependencies
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
        git \
        ca-certificates \
        && rm -rf /var/lib/apt/lists/*

    # Install Julia (required for PySR)
    # Julia 1.11+ fixes the libopenlibm executable stack issue with Singularity
    export JULIA_VERSION=1.11.5
    curl -fsSL https://julialang-s3.julialang.org/bin/linux/x64/1.11/julia-${JULIA_VERSION}-linux-x86_64.tar.gz | \
        tar -xz -C /opt
    ln -s /opt/julia-${JULIA_VERSION}/bin/julia /usr/local/bin/julia

    # Create app directory
    mkdir -p /app

    # Copy requirements and install Python dependencies
    # Note: requirements.txt must be in the same directory as the .def file during build
    # PySR is pinned: the backend relies on its `guesses` argument and equation string format
    pip install --no-cache-dir numpy pandas scipy pysr==2.7.0 juliacall requests

    # Pre-compile Julia packages into a fixed depot path (not /root/.julia)
    # so they persist and are readable at runtime
    export JULIA_DEPOT_PATH=/opt/julia-depot
    # Use the container's Julia and keep juliacall's environment inside the image, so
    # jobs reuse exactly what is resolved and precompiled here (same as %environment)
    export PYTHON_JULIAPKG_EXE=/usr/local/bin/julia
    export PYTHON_JULIAPKG_PROJECT=/opt/julia-env

    # Broad CPU target so precompiled native code is valid on HPC nodes
    export JULIA_CPU_TARGET="generic;sandybridge,-xsaveopt,clone_all;haswell,-rdrnd,base(1)"

    # Eagerly load all PySR Julia packages (triggers Pkg.precompile)
    python -c "import pysr; pysr.load_all_packages()" || true

    # Warm up with turbo=True to match production config and precompile
    # LoopVectorization dependencies (CpuId, Static, etc.)
    python -c "
from pysr import PySRRegressor
import numpy as np
print('Pre-compiling PySR Julia packages...')
model = PySRRegressor(niterations=1, turbo=True, verbosity=0, progress=False)
X = np.random.randn(10, 2)
y = np.random.randn(10)
try:
    model.fit(X, y)
except:
    pass  # First run may fail but Julia is compiled
print('Julia pre-compilation complete')
" || true

    # Jobs run as an unprivileged user: everything preloaded must be readable
    chmod -R a+rX /opt/julia-env /opt/julia-depot

    # Clean up (avoid /tmp and /var/tmp as they may contain host files with fakeroot)
    apt-get clean || true
    rm -rf /var/lib/apt/lists/* || true

%files
    # Copy worker code into container
    __init__.py /app/slurm_worker/__init__.py
    __main__.py /app/slurm_worker/__main__.py
    cli.py /app/slurm_worker/cli.py
    config.py /app/slurm_worker/config.py
    logging_config.py /app/slurm_worker/logging_config.py
    io/ /app/slurm_worker/io
    reporting/ /app/slurm_worker/reporting
    tasks/ /app/slurm_worker/tasks

%environment
    export PYTHONUNBUFFERED=1
    export PYTHONPATH=/app
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    # Julia depot stacking: writable persistent storage on top of read-only precompiled depot
    export JULIA_DEPOT_PATH="/storage/ai4science/syxplain/.julia:/opt/julia-depot"
    # Force pyjuliapkg to use the container's Julia instead of downloading its own
    export PYTHON_JULIAPKG_EXE=/usr/local/bin/julia
    # Load the Julia environment resolved and precompiled at build time directly: with both
    # set, juliacall skips juliapkg (no resolve, no lock file, no download) on the
    # read-only image
    export PYTHON_JULIACALL_EXE=/usr/local/bin/julia
    export PYTHON_JULIACALL_PROJECT=/opt/julia-env
    # Broad CPU target matching the build-time precompilation
    export JULIA_CPU_TARGET="generic;sandybridge,-xsaveopt,clone_all;haswell,-rdrnd,base(1)"
    # Julia threading - will be overridden by SLURM_CPUS_PER_TASK in the worker
    export JULIA_NUM_THREADS=${SLURM_CPUS_PER_TASK:-4}

%runscript
    exec python -m slurm_worker "$@"

%test
    python -c "import sys; sys.path.insert(0, '/app'); from slurm_worker import __version__; print(f'Version: {__version__}')"
    # /storage (the runtime depot) is not mounted during a build: use a scratch depot.
    # juliacall loads the baked environment directly (%environment), so this fails if a job
    # would still need to resolve or download anything.
    JULIA_DEPOT_PATH="$(mktemp -d):/opt/julia-depot" python -c "
import time
t = time.time()
from pysr import PySRRegressor
import numpy as np
X = np.random.randn(20, 2)
PySRRegressor(niterations=1, turbo=True, verbosity=0, progress=False).fit(X, X[:, 0] + X[:, 1])
print(f'PySR OK: import + fit in {time.time() - t:.0f}s, offline')
"

%help
    Syxplain Worker Container

    This container runs compute-intensive PySR tasks for the Syxplain
    symbolic regression analysis platform.

    Usage:
        singularity run syxplain-worker.sif --help
        singularity run syxplain-worker.sif --task-type pysr --run-id <id> --input <file> --output <file>

    With bind mounts for data access:
        singularity run --bind /storage:/storage syxplain-worker.sif \
            --task-type pysr \
            --run-id abc123 \
            --input /storage/staging/abc123/input.json \
            --output /storage/staging/abc123/output.json

    Environment variables (set before running):
        CALLBACK_URL   - Backend API URL for progress reporting
        CALLBACK_TOKEN - Authentication token for callbacks

    For more information, see: https://github.com/HUN-REN-AI1Science/syxplain
