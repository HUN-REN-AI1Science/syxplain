# ═══════════════════════════════════════════════════════════════════════════════
# REQUIRED - Core Configuration
# ═══════════════════════════════════════════════════════════════════════════════

# LLM API (OpenAI-compatible)
OPENAI_API_KEY="sk-..."
OPENAI_API_BASE="https://genai.uni-obuda.hu/api/"
OPENAI_MODEL_NAME="gemini-2.5-flash"

# Small model for lightweight tasks (column description suggestions)
SMALL_MODEL_NAME="gpt-5-mini"
SMALL_USER_MODEL_NAME="gemini-2.5-flash"

# Database (local development with docker-compose)
DATABASE_URL="postgresql://syxplain:syxplain@localhost:5432/syxplain"

# ═══════════════════════════════════════════════════════════════════════════════
# REQUIRED - Slurm HPC Integration
# ═══════════════════════════════════════════════════════════════════════════════

# Slurm REST API endpoint
# Production:        http://slurm.science-cloud.hu:6820 (direct access)
# Local dev native:  http://localhost:6820 (via SSH tunnel)
# Local dev Docker:  http://host.docker.internal:6820 (via SSH tunnel)
SLURM_API_URL="http://slurm.science-cloud.hu:6820"

# Auth token from: ssh <user>@slurm... "scontrol token username=<user> lifespan=31536000"
SLURM_AUTH_TOKEN="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SLURM_USER_NAME="ai4science"
SLURM_STAGING_DIR="/storage/ai4science/syxplain"

# Singularity container path (required for production)
# Build with: slurm_worker/build-singularity.sh
SLURM_CONTAINER_PATH="/storage/ai4science/syxplain/containers/syxplain-worker.sif"

# ═══════════════════════════════════════════════════════════════════════════════
# REQUIRED - Authentication (Keycloak)
# ═══════════════════════════════════════════════════════════════════════════════

# Backend (internal Docker URL — used for JWKS + Admin API)
KEYCLOAK_URL="http://keycloak:8080/keycloak"
KEYCLOAK_REALM="syxplain"
KEYCLOAK_CLIENT_ID="syxplain-frontend"
KEYCLOAK_ADMIN_USERNAME="admin"
KEYCLOAK_ADMIN_PASSWORD="admin"
# Issuer validation (leave empty for dev; set in production)
KEYCLOAK_ISSUER=""

# Frontend (browser-accessible URL)
VITE_KEYCLOAK_URL="http://localhost:8080/keycloak"
VITE_KEYCLOAK_REALM="syxplain"
VITE_KEYCLOAK_CLIENT_ID="syxplain-frontend"
VITE_ENABLE_MICROSOFT_SSO="false"

# Production database & Keycloak (only for docker-compose.prod.yml)
# POSTGRES_PASSWORD="change-me-in-production"
# KC_DB_PASSWORD="change-me-in-production"
# KC_HOSTNAME="syxplain.ai1science.net"

# ═══════════════════════════════════════════════════════════════════════════════
# OPTIONAL - Slurm Resource Allocation
# ═══════════════════════════════════════════════════════════════════════════════

SLURM_PARTITION="cpu_m2.2xlarge"
SLURM_CPUS=4                    # CPUs per job
SLURM_MEMORY="7941M"            # Memory per job (max 7941 MB)
SLURM_TIME_LIMIT="04:00:00"     # Max job time (HH:MM:SS)
SLURM_RETRY_INTERVAL=60         # Seconds to wait before retrying on quota errors

# ═══════════════════════════════════════════════════════════════════════════════
# OPTIONAL - Progress Callbacks
# ═══════════════════════════════════════════════════════════════════════════════

# Worker will POST progress updates to this URL (use ngrok for local dev)
WORKER_CALLBACK_URL="https://your-domain.com/api/internal"
WORKER_CALLBACK_TOKEN="your-secure-token"

# ═══════════════════════════════════════════════════════════════════════════════
# OPTIONAL - Advanced Features
# ═══════════════════════════════════════════════════════════════════════════════

# The literature search uses OPENAI_MODEL_NAME and OPENAI_API_KEY (Responses API web search)

# Cost accounting: every run logs "ANALYTICS run_usage {...}" (tokens, web searches, USD per
# model) and stores the same summary in its results. Prices for OpenAI models are built in;
# add or override them as USD per 1M tokens [input, cached input, output]:
# LLM_PRICES_JSON='{"gemini-3.1-pro-preview": [2.0, 0.2, 12.0]}'
# LLM_WEB_SEARCH_USD=0.01            # per web search call

# User API Models (Gemini models for users providing their own API keys)
USER_API_MODELS="gemini-3.1-pro-preview,gemini-3-pro-preview,gemini-2.5-pro"

# GitHub Feedback (optional — creates GitHub issues for user feedback)
GITHUB_FEEDBACK_TOKEN=""
GITHUB_FEEDBACK_REPO_OWNER=""
GITHUB_FEEDBACK_REPO_NAME=""

# CORS (use "*" for dev, specific origins for production)
CORS_ORIGINS="*"

# Agentic equation discovery (budget ceilings; the agent stops earlier when it is done)
DISCOVERY_AGENT_ENABLED=true      # false = fixed pipeline: one PySR search, no agent
DISCOVERY_AGENT_MODEL=""          # agent model for server keys (default: OPENAI_MODEL_NAME)
DISCOVERY_MAX_ITERS=40            # agent reasoning steps
DISCOVERY_MAX_PYSR_RUNS=6         # PySR searches per run (incl. the baseline search)
DISCOVERY_WALL_CLOCK_MIN=150      # agent time budget (minutes)
DISCOVERY_MAX_CONCURRENT_PYSR=2   # PySR searches running at the same time
DISCOVERY_PYSR_TIMEOUT_S=1800     # per-search PySR timeout (seconds)
DISCOVERY_REVIEW_STEPS=5          # read-only agent steps for searches that finish after it stopped (0 = off)
DISCOVERY_FIRST_RESULT_TIMEOUT_S=3600  # max wait for a first PySR result when none has completed
DISCOVERY_SPARSE_COLUMN_THRESHOLD=0.2  # drop a predictor whose missing values alone remove >20% of rows
DISCOVERY_MAX_CATEGORICAL_LEVELS=10    # consecutive integer codes with up to this many levels = categorical

# Analysis timeout (hours, 0 to disable)
ANALYSIS_TIMEOUT_HOURS=24

# ═══════════════════════════════════════════════════════════════════════════════
