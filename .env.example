# Backend Environment Variables

# OpenAI
OPENAI_API_KEY="sk-..."
OPENAI_API_BASE="https://genai.uni-obuda.hu/api/"
OPENAI_MODEL_NAME="gemini-2.5-flash"

# Deep Research Model (for Deep Analysis mode)
DEEP_RESEARCH_MODEL="o4-mini-deep-research"
DEEP_RESEARCH_API_KEY="sk-..."
DEEP_RESEARCH_API_BASE="https://api.openai.com/v1"

# User API Models (for users providing their own API keys)
USER_API_MODELS="gpt-4o,gpt-4.1"

# Admin Configuration
# Comma-separated list of admin email addresses
ADMIN_EMAILS="admin@example.com"

# Database (for local development with docker-compose)
DATABASE_URL="postgresql://syxplain:syxplain@localhost:5432/syxplain"

# Supabase (Backend)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_JWT_SECRET="your-jwt-secret"
# Required for GDPR account deletion - get from Supabase Dashboard > Settings > API
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Supabase (Frontend)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Slurm Configuration (required)
# The Slurm REST API is publicly accessible - no SSH tunnel required
# SSH is only needed to generate the auth token via 'scontrol token'
SLURM_API_URL="http://slurm.science-cloud.hu:6820"
SLURM_AUTH_TOKEN="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SLURM_USER_NAME="ai4science"
SLURM_PARTITION="batch_cpu_m2.large"
SLURM_STAGING_DIR="/storage/ai4science/syxplain"

# Slurm Resource Allocation
# These define resources requested per job
SLURM_CPUS=4           # CPUs per job (partition has 16 total across 4 nodes)
SLURM_MEMORY="8G"      # Memory per job (partition has ~31GB total)
SLURM_TIME_LIMIT="04:00:00"  # Max job time (partition allows up to 7 days)

# CORS (Backend)
# For development, use "*" to allow all origins
# For production, specify comma-separated list of allowed origins
CORS_ORIGINS="*"

# SHAP Subsampling (Backend)
# Controls data subsampling for faster SHAP interaction value computation
SHAP_SUBSAMPLE_FRACTION=0.1  # Fraction of data to use (default: 10%)
SHAP_SUBSAMPLE_MIN=1000      # Minimum number of samples
SHAP_SUBSAMPLE_MAX=5000      # Maximum number of samples

# Langfuse (Optional - for LLM tracing)
# Get keys from https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY="pk-lf-..."
LANGFUSE_SECRET_KEY="sk-lf-..."
LANGFUSE_BASE_URL="https://cloud.langfuse.com"

# Analysis Timeout
# Maximum hours before an analysis is killed with timeout status
# Set to 0 to disable timeout
ANALYSIS_TIMEOUT_HOURS=24
