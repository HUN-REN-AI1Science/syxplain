# Backend Environment Variables

# OpenAI
OPENAI_API_KEY="sk-..."
OPENAI_API_BASE="https://genai.uni-obuda.hu/api/"
OPENAI_MODEL_NAME="gemini-2.5-flash"

# Database
DATABASE_URL="postgresql://user:password@host:port/database"

# Supabase (Backend)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_JWT_SECRET="your-jwt-secret"

# Supabase (Frontend)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY="your-publishable-key"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Julia
JULIA_NUM_THREADS=10

# CORS (Backend)
# For development, use "*" to allow all origins
# For production, specify comma-separated list of allowed origins
CORS_ORIGINS="*"
