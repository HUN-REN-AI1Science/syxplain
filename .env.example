# ═══════════════════════════════════════════════════════════════════════════════
# REQUIRED - Core Configuration
# ═══════════════════════════════════════════════════════════════════════════════

# LLM API (OpenAI-compatible)
OPENAI_API_KEY="sk-..."
OPENAI_API_BASE="https://genai.uni-obuda.hu/api/"
OPENAI_MODEL_NAME="gemini-2.5-flash"

# Database (local development with docker-compose)
DATABASE_URL="postgresql://syxplain:syxplain@localhost:5432/syxplain"

# ═══════════════════════════════════════════════════════════════════════════════
# REQUIRED - Slurm HPC Integration
# ═══════════════════════════════════════════════════════════════════════════════

# Slurm REST API endpoint
# Production:        http://slurm.science-cloud.hu:6820 (direct access)
# Local dev native:  http://localhost:6820 (via SSH tunnel)
# Local dev Docker:  http://host.docker.internal:6820 (via SSH tunnel)
SLURM_API_URL="http://slurm.science-cloud.hu:6820"

# Auth token from: ssh <user>@slurm... "scontrol token username=<user> lifespan=31536000"
SLURM_AUTH_TOKEN="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SLURM_USER_NAME="ai4science"
SLURM_STAGING_DIR="/storage/ai4science/syxplain"

# Singularity container path (required for production)
# Build with: slurm_worker/build-singularity.sh
SLURM_CONTAINER_PATH="/storage/ai4science/syxplain/containers/syxplain-worker.sif"

# ═══════════════════════════════════════════════════════════════════════════════
# REQUIRED - Authentication (Supabase)
# ═══════════════════════════════════════════════════════════════════════════════

# Backend
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_JWT_SECRET="your-jwt-secret"
# Required for GDPR account deletion - get from Supabase Dashboard > Settings > API
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Frontend
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# ═══════════════════════════════════════════════════════════════════════════════
# OPTIONAL - Slurm Resource Allocation
# ═══════════════════════════════════════════════════════════════════════════════

SLURM_PARTITION="batch_cpu_m2.large"
SLURM_CPUS=4                    # CPUs per job
SLURM_MEMORY="7941M"            # Memory per job (max 7941 MB)
SLURM_TIME_LIMIT="04:00:00"     # Max job time (HH:MM:SS)
SLURM_RETRY_INTERVAL=60         # Seconds to wait before retrying on quota errors

# ═══════════════════════════════════════════════════════════════════════════════
# OPTIONAL - Progress Callbacks
# ═══════════════════════════════════════════════════════════════════════════════

# Worker will POST progress updates to this URL (use ngrok for local dev)
WORKER_CALLBACK_URL="https://your-domain.com/api/internal"
WORKER_CALLBACK_TOKEN="your-secure-token"

# ═══════════════════════════════════════════════════════════════════════════════
# OPTIONAL - Advanced Features
# ═══════════════════════════════════════════════════════════════════════════════

# Deep Research Model (for Deep Analysis mode)
DEEP_RESEARCH_MODEL="o4-mini-deep-research"
DEEP_RESEARCH_API_KEY="sk-..."
DEEP_RESEARCH_API_BASE="https://api.openai.com/v1"

# User API Models (for users providing their own API keys)
USER_API_MODELS="gpt-4o,gpt-4.1"

# Admin emails (comma-separated, for /admin access)
ADMIN_EMAILS="admin@example.com"

# GitHub Feedback (optional — creates GitHub issues for user feedback)
GITHUB_FEEDBACK_TOKEN=""
GITHUB_FEEDBACK_REPO_OWNER=""
GITHUB_FEEDBACK_REPO_NAME=""

# CORS (use "*" for dev, specific origins for production)
CORS_ORIGINS="*"

# SHAP subsampling (tune for performance vs accuracy)
SHAP_SUBSAMPLE_FRACTION=0.1   # Fraction of data to use (default: 10%)
SHAP_SUBSAMPLE_MIN=1000       # Minimum samples
SHAP_SUBSAMPLE_MAX=5000       # Maximum samples

# Analysis timeout (hours, 0 to disable)
ANALYSIS_TIMEOUT_HOURS=24

# ═══════════════════════════════════════════════════════════════════════════════
# OPTIONAL - LLM Tracing (Langfuse)
# ═══════════════════════════════════════════════════════════════════════════════

# Get keys from https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY="pk-lf-..."
LANGFUSE_SECRET_KEY="sk-lf-..."
LANGFUSE_BASE_URL="https://cloud.langfuse.com"
