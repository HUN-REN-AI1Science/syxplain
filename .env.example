# Syxplain configuration
#
# Local development:  cp .env.example .env, set OPENAI_API_KEY, run `docker compose up --build`.
# Everything else has working defaults in docker-compose.yml (database, Keycloak, a local
# Slurm emulator). docs/configuration.md describes every variable.

# ═══════════════════════════════════════════════════════════════════════════════
# LLM (required)
# ═══════════════════════════════════════════════════════════════════════════════

# Server-side key, used for users with server-key access (see SERVER_KEYS_ROLE).
# The literature scout uses the OpenAI Responses API web-search tool, so an OpenAI
# key on the default endpoint gives the full pipeline.
OPENAI_API_KEY="sk-..."
# OpenAI-compatible endpoint; leave empty for api.openai.com
OPENAI_API_BASE=""
OPENAI_MODEL_NAME="gpt-4o"

# Small model for lightweight tasks (column description suggestions)
SMALL_MODEL_NAME="gpt-5-mini"
# Small model used with a user's own Gemini key
SMALL_USER_MODEL_NAME="gemini-2.5-flash"
# Models users can choose when they bring their own key
USER_API_MODELS="gemini-3.1-pro-preview,gemini-3-pro-preview,gemini-2.5-pro"

# ═══════════════════════════════════════════════════════════════════════════════
# Local development extras
# ═══════════════════════════════════════════════════════════════════════════════

# true = run real PySR searches in the local Slurm emulator (Julia + PySR are installed
# into the image on the first build, 10-20 minutes). false = fast fake least-squares results.
# LOCAL_PYSR=false
# (SLURM_CPUS below also sets the CPUs each local search may use)

# ═══════════════════════════════════════════════════════════════════════════════
# Slurm cluster (optional in development, required in production)
# ═══════════════════════════════════════════════════════════════════════════════
# Leave these commented out in development: docker-compose.yml then uses the local
# emulator (http://mock-slurm:6820). See docs/slurm.md for setting up a real cluster.

# SLURM_API_URL="http://slurm.example.org:6820"
# Token from: ssh <user>@<login-node> "scontrol token username=<user> lifespan=31536000"
# SLURM_AUTH_TOKEN="<jwt-from-scontrol-token>"
# SLURM_USER_NAME="<cluster-user>"
# Shared directory for job logs and output (must exist on the cluster)
# SLURM_STAGING_DIR="/storage/<cluster-user>/syxplain"
# Worker image; without it, jobs run `python -m slurm_worker` in a conda env `syxplain_worker`
# SLURM_CONTAINER_PATH="/storage/<cluster-user>/syxplain/containers/syxplain-worker.sif"
# Host paths mounted into the container (comma-separated; default: SLURM_STAGING_DIR)
# SLURM_CONTAINER_BINDS="/storage"
# Writable Julia depot on shared storage (default: $SLURM_STAGING_DIR/.julia)
# SLURM_JULIA_DEPOT=""

# Resources per job
# SLURM_PARTITION=""              # empty = the cluster's default partition
# SLURM_CPUS=4
# SLURM_MEMORY="8G"
# SLURM_TIME_LIMIT="04:00:00"
# SLURM_RETRY_INTERVAL=60         # seconds to wait before retrying on quota errors

# Workers fetch their input from and report progress to this URL. In development the
# compose default (http://backend:8000/api/internal) is right for the local emulator;
# with a real cluster it must be reachable from the compute nodes.
# WORKER_CALLBACK_URL="https://syxplain.example.org/api/internal"
# WORKER_CALLBACK_TOKEN="<random-secret>"
# JOB_POLL_INTERVAL=10
# COMPUTE_MAX_RETRIES=3

# ═══════════════════════════════════════════════════════════════════════════════
# Authentication (Keycloak)
# ═══════════════════════════════════════════════════════════════════════════════

# Backend (internal Docker URL, used for JWKS and the Admin API)
KEYCLOAK_URL="http://keycloak:8080/keycloak"
KEYCLOAK_REALM="syxplain"
KEYCLOAK_CLIENT_ID="syxplain-frontend"
KEYCLOAK_ADMIN_USERNAME="admin"
KEYCLOAK_ADMIN_PASSWORD="admin"
# Token issuer check: empty in development; https://<domain>/keycloak/realms/syxplain in production
KEYCLOAK_ISSUER=""

# Realm role that lets a user run on the server's LLM keys (syxplain-admin always can)
SERVER_KEYS_ROLE="server-llm-access"

# Keycloak clients whose access tokens the backend accepts (comma-separated; empty = any
# client of the realm). In production: the web client plus the technical clients created
# with dev/create-technical-client.sh, e.g. "syxplain-frontend,adp-librechat"
# KEYCLOAK_ALLOWED_CLIENTS=""

# Frontend (browser-accessible URL)
VITE_KEYCLOAK_URL="http://localhost:8080/keycloak"
VITE_KEYCLOAK_REALM="syxplain"
VITE_KEYCLOAK_CLIENT_ID="syxplain-frontend"

# ═══════════════════════════════════════════════════════════════════════════════
# Discovery agent (budget ceilings; the agent stops earlier when it is done)
# ═══════════════════════════════════════════════════════════════════════════════

# DISCOVERY_AGENT_ENABLED=true          # false = fixed pipeline: one PySR search, no agent
# DISCOVERY_AGENT_MODEL=""              # agent model for server keys (default: OPENAI_MODEL_NAME)
# DISCOVERY_MAX_ITERS=40                # agent reasoning steps
# DISCOVERY_MAX_PYSR_RUNS=6             # PySR searches per run (incl. the baseline search)
# DISCOVERY_MAX_SINDY_RUNS=6            # SINDy rate-law searches per run (seconds each, in the backend)
# DISCOVERY_WALL_CLOCK_MIN=150          # agent time budget (minutes)
# DISCOVERY_MAX_CONCURRENT_PYSR=2       # PySR searches running at the same time
# DISCOVERY_SHAP_IMAGES=true            # show SHAP plots to the agent as images (text SHAP is always given)
# DISCOVERY_PYSR_TIMEOUT_S=1800         # per-search PySR timeout (seconds)
# DISCOVERY_REVIEW_STEPS=5              # read-only agent steps for searches that finish after it stopped
# DISCOVERY_FIRST_RESULT_TIMEOUT_S=3600 # max wait for a first PySR result when none has completed
# DISCOVERY_SPARSE_COLUMN_THRESHOLD=0.2 # drop a predictor whose missing values alone remove >20% of rows
# DISCOVERY_MAX_CATEGORICAL_LEVELS=10   # consecutive integer codes with up to this many levels = categorical

# ═══════════════════════════════════════════════════════════════════════════════
# Other optional settings
# ═══════════════════════════════════════════════════════════════════════════════

# ANALYSIS_TIMEOUT_HOURS=24       # 0 disables the run timeout
# MAX_FILE_SIZE_MB=50
# MAX_ACTIVE_RUNS_PER_USER=3      # pending + running analyses per account; 0 = unlimited
# MCP_MAX_CSV_KB=256              # largest inline CSV the MCP start_analysis tool accepts
# CORS_ORIGINS="*"                # comma-separated origins in production

# Cost accounting: every run logs "ANALYTICS run_usage {...}" and stores the same summary in
# its results. OpenAI prices are built in; add or override USD per 1M tokens
# [input, cached input, output]:
# LLM_PRICES_JSON='{"gemini-3.1-pro-preview": [2.0, 0.2, 12.0]}'
# LLM_WEB_SEARCH_USD=0.01         # per web search call

# In-app feedback creates GitHub issues when all three are set (otherwise it is only logged)
# GITHUB_FEEDBACK_TOKEN=""
# GITHUB_FEEDBACK_REPO_OWNER=""
# GITHUB_FEEDBACK_REPO_NAME=""

# Database connection pool
# DB_POOL_SIZE=40
# DB_MAX_OVERFLOW=5
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=300

# ═══════════════════════════════════════════════════════════════════════════════
# Production only (docker-compose.prod.yml, see docs/deployment.md)
# ═══════════════════════════════════════════════════════════════════════════════

# POSTGRES_PASSWORD="<strong-password>"
# KC_DB_PASSWORD="<strong-password>"
# KC_HOSTNAME="syxplain.example.org"
# SERVER_NAME="syxplain.example.org"    # nginx server_name; HTTPS when a Let's Encrypt cert exists
# BACKEND_IMAGE="ghcr.io/<owner>/syxplain-backend:latest"
# FRONTEND_IMAGE="ghcr.io/<owner>/syxplain-frontend:latest"
# BACKEND_PORT=8000
# FRONTEND_HTTP_PORT=80
# FRONTEND_HTTPS_PORT=443
# BACKEND_CPU_LIMIT=4
# BACKEND_MEMORY_LIMIT="4G"
